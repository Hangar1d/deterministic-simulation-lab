if(NOT DEFINED SIMLAB OR NOT DEFINED SOURCE OR NOT DEFINED WORK OR NOT DEFINED CASE)
    message(FATAL_ERROR "CLI test arguments missing")
endif()
file(MAKE_DIRECTORY "${WORK}")
# Remove only files generated by these tests in their dedicated build directory.
file(REMOVE "${WORK}/one.record" "${WORK}/two.record" "${WORK}/tampered.record"
    "${WORK}/checkpoint.snapshot" "${WORK}/bad.snapshot" "${WORK}/existing.record"
    "${WORK}/bad.plan" "${WORK}/should-not-exist.snapshot")
set(plan "${SOURCE}/examples/queue.plan")
file(READ "${SOURCE}/examples/queue.expected.txt" expected)

function(run_ok output)
    execute_process(COMMAND "${SIMLAB}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE error)
    if(NOT "${status}" STREQUAL "0" OR NOT "${error}" STREQUAL "")
        message(FATAL_ERROR "Expected success, got ${status}: ${error}")
    endif()
    # Terminal text streams may translate LF to CRLF on Windows. Record and
    # snapshot files are binary-mode LF; their comparisons below are exact.
    string(REPLACE "\r\n" "\n" text "${text}")
    set(${output} "${text}" PARENT_SCOPE)
endfunction()

function(run_bad expected_code)
    execute_process(COMMAND "${SIMLAB}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE error)
    if(NOT "${status}" STREQUAL "${expected_code}" OR NOT "${text}" STREQUAL "" OR "${error}" STREQUAL "")
        message(FATAL_ERROR "Expected error ${expected_code}, got ${status}; stdout=${text}; stderr=${error}")
    endif()
    set(last_error "${error}" PARENT_SCOPE)
endfunction()

if(CASE STREQUAL "reproducible")
    run_ok(first run "${plan}")
    run_ok(second run "${plan}")
    if(NOT "${first}" STREQUAL "${second}" OR NOT "${first}" STREQUAL "${expected}")
        message(FATAL_ERROR "Repeated runs differ or do not match the checked-in golden result")
    endif()
elseif(CASE STREQUAL "record_replay")
    run_ok(first record "${plan}" "${WORK}/one.record")
    run_ok(second record "${plan}" "${WORK}/two.record")
    run_ok(replayed replay "${WORK}/one.record")
    file(SHA256 "${WORK}/one.record" one)
    file(SHA256 "${WORK}/two.record" two)
    if(NOT "${first}" STREQUAL "${expected}" OR NOT "${replayed}" STREQUAL "${first}" OR NOT one STREQUAL two)
        message(FATAL_ERROR "Record/replay is not reproducible")
    endif()
elseif(CASE STREQUAL "tampered_record")
    run_ok(recorded record "${plan}" "${WORK}/one.record")
    file(READ "${WORK}/one.record" record)
    string(REPLACE "duration 4" "duration 5" tampered "${record}")
    # Keep the length-prefixed record canonical on Windows as well.
    file(CONFIGURE OUTPUT "${WORK}/tampered.record" CONTENT "${tampered}"
        @ONLY NEWLINE_STYLE LF)
    run_bad(1 replay "${WORK}/tampered.record")
    if(NOT last_error MATCHES "replay mismatch")
        message(FATAL_ERROR "Tampered replay did not fail for the expected reason: ${last_error}")
    endif()
elseif(CASE STREQUAL "snapshot_resume")
    run_ok(checkpoint checkpoint "${plan}" 4 "${WORK}/checkpoint.snapshot")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
        "${WORK}/checkpoint.snapshot" "${SOURCE}/examples/queue.after4.snapshot" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Checkpoint differs from the independently specified fixture")
    endif()
    run_ok(resumed resume "${WORK}/checkpoint.snapshot")
    string(FIND "${expected}" "state\n" start)
    string(SUBSTRING "${expected}" ${start} -1 final_state)
    string(FIND "${resumed}" "state\n" resumed_start)
    if(resumed_start LESS 0)
        message(FATAL_ERROR "Resumed result is missing final state")
    endif()
    string(SUBSTRING "${resumed}" ${resumed_start} -1 resumed_state)
    if(NOT "${final_state}" STREQUAL "${resumed_state}")
        message(FATAL_ERROR "Checkpoint/resume changed the final state")
    endif()
elseif(CASE STREQUAL "invalid_io")
    run_bad(2)
    run_bad(2 unsupported)
    run_bad(1 run "${WORK}/missing.plan")
    file(WRITE "${WORK}/bad.plan" "SIMLAB_PLAN 1 config -1 2 5 jobs 0 end\n")
    run_bad(1 run "${WORK}/bad.plan")
    file(WRITE "${WORK}/existing.record" "preserve me\n")
    run_bad(1 record "${plan}" "${WORK}/existing.record")
    file(READ "${WORK}/existing.record" sentinel)
    if(NOT "${sentinel}" STREQUAL "preserve me\n")
        message(FATAL_ERROR "Existing output was overwritten")
    endif()
    run_bad(1 checkpoint "${plan}" 99 "${WORK}/should-not-exist.snapshot")
    if(EXISTS "${WORK}/should-not-exist.snapshot")
        message(FATAL_ERROR "Failed checkpoint created an output file")
    endif()
    run_bad(1 checkpoint "${plan}" -1 "${WORK}/should-not-exist.snapshot")
elseif(CASE STREQUAL "invalid_snapshot")
    file(READ "${SOURCE}/examples/queue.after4.snapshot" snapshot)
    string(REPLACE "rng 182605794" "rng 0" invalid "${snapshot}")
    file(WRITE "${WORK}/bad.snapshot" "${invalid}")
    run_bad(1 resume "${WORK}/bad.snapshot")
else()
    message(FATAL_ERROR "Unknown CLI test case: ${CASE}")
endif()
